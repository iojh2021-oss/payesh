        "sideloaded"
      ],
      "any": [
        "perm:SYSTEM_ALERT_WINDOW",
        "perm:WRITE_EXTERNAL_STORAGE"
      ],
      "none": [
        "system"
      ]
    },
    {
      "id": "otp.listener",
      "name": "شنود کد یک‌بارمصرف: دسترسی اعلان‌ها + پیامک",
      "score": 20,
      "all": [
        "notif_on",
        "sms_any",
        "sideloaded"
      ],
      "none": [
        "system"
      ]
    },
    {
      "id": "adware.hidden",
      "name": "الگوی ادویر: پنهان + اینترنت + اجرا هنگام روشن شدن",
      "score": 15,
